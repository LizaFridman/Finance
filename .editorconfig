root = true

[*]
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Namespaces / structure — the codebase already follows these.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# `this.` is never used in this codebase.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# These describe the conventions the codebase already follows — set to :silent so
# the analyzer neither rewrites existing code nor nags on new code that matches.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
csharp_prefer_braces = when_multiline:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = when_on_single_line:silent
csharp_style_expression_bodied_lambdas = when_on_single_line:silent
dotnet_style_prefer_conditional_expression_over_return = false:silent
dotnet_style_prefer_conditional_expression_over_assignment = false:silent

# --- Analyzer rules deliberately turned off for this codebase -----------------
# Solo, C#-only solution reachable only over a private tailnet: cross-language
# (VB) interop portability is a non-goal.
dotnet_diagnostic.CA1716.severity = none   # member names vs. VB keywords (Get/Set/To)
# "dictionary" is domain vocabulary here (the Layer-1 merchant dictionary, spec §10),
# not a System.Collections type.
dotnet_diagnostic.CA1711.severity = none   # type name ends in 'Dictionary'
# Returning read-only interfaces is an intentional API choice; the micro-alloc
# saving from returning concrete List is not worth the leak.
dotnet_diagnostic.CA1859.severity = none
# Instance methods on DI-registered services stay instance methods even when they
# don't touch fields yet.
dotnet_diagnostic.CA1822.severity = suggestion

# Test projects: xunit's Method_Name_With_Underscores convention is deliberate,
# and the perf/culture analyzers add only noise to assertion code.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.CA1305.severity = none
# Windows-only APIs are runtime-guarded by Skip.IfNot(OperatingSystem.IsWindows()).
dotnet_diagnostic.CA1416.severity = none

[*.{json,js,ts,tsx,yml,yaml}]
indent_size = 2

[*.{xml,csproj,props,targets}]
indent_size = 2
