# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# or uploaded anywhere (spec §7.2). The C# ingestion orchestrator is the intended
# owner of these values — it can inject them into this process instead of a file.

LEUMI_USERNAME=
LEUMI_PASSWORD=

CAL_USERNAME=
CAL_PASSWORD=

# Max is registered dormant (spec §6) but its 2025 history still matters.
MAX_USERNAME=
MAX_PASSWORD=
MAX_ID=

# Optional: where normalized JSON is written (default: ../Raw Data Feed)
# RAW_DATA_FEED=../Raw Data Feed
